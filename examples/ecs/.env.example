AGENT_MYSQL_DSN=agent:agent_dev_password@tcp(mysql:3306)/agent?parseTime=true&charset=utf8mb4&collation=utf8mb4_0900_ai_ci
AGENT_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
AGENT_HTTP_ADDRESS=:8080
AGENT_ROOT=/app
AGENT_WORKSPACE_ROOT=/workspace
AGENT_WORKER_CONCURRENCY=4
AGENT_WORKER_POLL_INTERVAL=1s
AGENT_WORKER_LEASE_DURATION=60s
# worker = Go-only default; worker-full = Node 24/npm/npx/curl compatibility image.
AGENT_WORKER_DOCKER_TARGET=worker
AGENT_DB_MAX_OPEN=20
AGENT_DB_MAX_IDLE=10
AGENT_DB_CONN_MAX_LIFETIME=5m
AGENT_OUTBOX_WEBHOOK_URL=
AGENT_OUTBOX_SECRET=
AGENT_OUTBOX_BATCH=50
AGENT_OUTBOX_TIMEOUT=10s
AGENT_MCP_CONFIG=
# USD per 1M tokens, keyed by provider then model.
# AGENT_MODEL_PRICING_JSON={"openai":{"gpt-5":{"input":1.25,"output":10,"cacheRead":0.125,"cacheWrite":0}}}
AGENT_ALLOW_GLOBAL_PACKAGE_MUTATIONS=false
# Native providers
OPENAI_API_KEY=
OPENAI_CODEX_TOKEN=
OPENAI_ACCOUNT_ID=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_API_VERSION=v1
# AGENT_PROVIDER_AZURE_OPENAI_RESPONSES_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
AGENT_IMAGE_MODEL=google/gemini-3.1-flash-image
# AGENT_IMAGE_BASE_URL=https://openrouter.ai/api/v1
# Optional native Chinese-web search Tool and web-researcher meta agent.
BOCHA_API_KEY=
BOCHA_API_BASE_URL=https://api.bochaai.com/v1/web-search
BOCHA_SEARCH_TIMEOUT=30s
# Bedrock uses AWS_REGION and the ECS task role.
AWS_REGION=us-east-1
# Any OpenAI-compatible provider:
# AGENT_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# AGENT_PROVIDER_DEEPSEEK_API_KEY=
# AGENT_PROVIDER_DEEPSEEK_HEADERS={"X-Tenant":"tenant-a"}
